# Keep secrets and local state out of the build context entirely, so they
# cannot end up in an image layer by accident.
.env
.env.*
!.env.example
*.pem
certs_real/

.git/
.github/
.omc/
.claude/
.venv/
.mise.local.toml

__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
htmlcov/
.coverage

tests/
docs/
scripts/
*.md
!README.md
Makefile
docker-compose.yml
docker-compose.override.yml
