# Telegram Bot Configuration
BOTTOKEN=your_telegram_bot_token_here

# Telegram updates are received with long polling. No public address, HTTPS
# certificate or port forwarding is required. Only one running bot may consume
# a token; startup removes any webhook that was registered in the past.

# Credential encryption (strongly recommended)
# Key material used to encrypt Korail credentials before they are written to
# Redis. If unset, an ephemeral key is used and stored sessions become
# unreadable after a restart.
#   generate: scripts/setup.sh secrets
SESSION_SECRET=
# How long an idle session - and the credentials in it - is kept. Default 24h.
SESSION_TTL_SECONDS=86400

# Restart recovery
#
# A search runs in a child process, so restarting the app (or rebooting the
# machine) leaves it without anything actually searching.
#
#   true   Resume the search automatically. Requires keeping the Korail
#          password while the search is alive: encrypted, in a key of its own,
#          deleted as soon as the search ends. Needs SESSION_SECRET to be set,
#          otherwise the stored value cannot be read back after the restart.
#   false  Tell the user the search was interrupted and clean it up.
#
# Searches that already reserved seats (random seating) are never resumed
# automatically - rebooking them would double up on seats you already hold.
RESUME_ON_RESTART=true
# 등록된 코레일 계정의 보관 기한(초). 기본 90일.
#
# 사용자가 /onboarding 으로 한 번 등록하면 그 뒤로는 로그인 없이 예약할 수
# 있다. 그 편의의 대가로 코레일 비밀번호가 예약과 예약 사이에도 Redis 에
# 남으므로, 암호화해 두고 기한이 지나면 스스로 사라지게 한다. /logout 이나
# 봇 차단 시에는 즉시 지워진다.
#CREDENTIAL_TTL_SECONDS=7776000

# Backstop expiry for those credentials. They are deleted when the search
# ends, so this only matters if that never happens. Default 3 days.
RESUME_TTL_SECONDS=259200

# Admin command password (REQUIRED for /cancelall, /broadcast, /flushredis, ...)
# Must NOT be the Korail password: this one is guessable over Telegram.
# Leave empty to disable every admin command.
ADMIN_PASSWORD=
ADMIN_MAX_AUTH_FAILURES=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_SESSION_TTL_SECONDS=3600

# 개발·테스트용 고정 코레일 계정 (선택)
#
# **개발자 모드인 채팅방에서만** 쓰인다(아래 ADMIN_MAGIC_STRING 참고).
# 그 방에서는 /start 가 휴대전화번호·비밀번호를 묻지 않고 이 계정으로 로그인한다.
#
# 일반 사용자는 이 값이 설정돼 있든 아니든 자기 코레일 계정을 등록해서 쓴다.
# 예전에는 설정만 하면 모든 사용자가 이 계정으로 예약했는데, 봇 링크를 아는
# 누구나 운영자의 코레일 계정을 쓸 수 있다는 뜻이어서 개발자 방으로 한정했다.
#
# A wrong password here is not fatal: the bot says so and falls back to
# asking for the credentials.
USERID=
USERPW=

# 개발·테스트용 고정 SRT 계정 (선택). 위 코레일 계정과 같은 규칙으로
# 개발자 모드인 채팅방에만 적용되며, 어느 철도를 고른 뒤 해당 계정만 쓴다.
# 코레일과 SRT 계정은 별개이므로 USERID/USERPW 를 대신 쓰지 않는다.
SRT_ID=
SRT_PW=

# 개발자 모드 전환 문자열. 비워두면 기능 자체가 꺼진다.
#
# 아무 채팅방에서든 이 문자열을 보내면 그 방이 개발자 모드가 된다. 개발자
# 방은 체험 횟수 제한이 없고, 관리자 명령을 비밀번호 없이 쓰며, 새 승인
# 요청 알림을 받는다. 위의 USERID/USERPW 가 설정돼 있으면 그 계정으로
# 로그인한다. 해제는 /devoff.
#
# 틀린 시도를 셀 수 없다 - 일반 메시지와 구분되지 않기 때문이다. 그래서
# 16자 이상으로, 실수로 보낼 일이 없는 값을 쓴다(짧으면 기동 시 경고한다).
# 진짜 값을 커밋하지 말 것: 저장소를 읽은 사람이 그대로 쓸 수 있다.
ADMIN_MAGIC_STRING=

# 이 봇을 쓸 수 있는 사람
#
# 승인 없이 바로 쓸 수 있는 번호 목록. 예전 이름은 ALLOW_LIST 였고 지금도
# 읽으므로 기존 .env 는 그대로 동작한다.
#
# 여기 없는 사람도 아래 TRIAL_SEARCH_LIMIT 만큼은 써볼 수 있고, 그 뒤에는
# 봇 안에서 운영자에게 승인을 요청한다. 즉 이 목록은 '허용된 사람 전부'가
# 아니라 '미리 승인해 둔 사람'이다.
#PREAPPROVED_USERS=010-1234-5678,010-9876-5432

# 승인 없이 써볼 수 있는 검색 횟수. 기본 3.
# 0 이면 처음부터 승인이 필요하고, 음수면 승인을 아예 요구하지 않는다.
#
# 코레일 전화번호 기준으로 센다. 텔레그램 계정은 새로 만들기 쉽지만 코레일
# 계정은 그렇지 않기 때문이다. 번호 자체는 저장하지 않고 SESSION_SECRET 으로
# 해시해 센다.
#TRIAL_SEARCH_LIMIT=3

# 답변받지 못한 승인 요청의 보관 기한(초). 기본 30일.
#REQUEST_TTL_SECONDS=2592000

# 서버에서 동시에 돌 수 있는 검색 수. 철도별 기본 5.
# 검색 하나가 몇 초마다 해당 철도에 요청을 보내며, 한 철도 입장에서는 전부
# 같은 IP 한 곳에서 온다. 코레일 5개와 SRT 5개는 함께 실행할 수 있다.
# 0 이면 제한하지 않는다.
#MAX_CONCURRENT_SEARCHES=5

# docker compose 가 띄울 이미지
# 비워두면 scripts/deploy.sh build 가 만드는 korailbot:local 을 씁니다. 즉
# 기본 동작은 '직접 빌드해서 직접 띄우기' 이고, 받아올 공용 이미지는 없습니다
# — 코레일 로그인을 다루는 봇을 남이 관리하는 이미지로 띄우는 것이
# 기본값이어서는 안 되기 때문입니다. 직접 레지스트리에 발행해 쓴다면 그
# 태그를 지정하세요.
#IMAGE_NAME=you/korailbot:latest

# Redis Configuration (don't change host/port if using docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required by docker-compose: Redis is started with --requirepass.
#   generate: scripts/setup.sh secrets
REDIS_PASSWORD=

# Flask Configuration
# Leave unset so only background reservation processes on loopback can reach it.
#FLASK_HOST=127.0.0.1
FLASK_PORT=8080
# Must stay False on any reachable host: the Werkzeug debugger allows
# remote code execution.
FLASK_DEBUG=False

# Search pacing
# Base wait between Korail requests while a search is running, in seconds.
SEARCH_INTERVAL=3
# How far each wait is allowed to stray from that base, as a fraction of it.
# 0.4 means every wait is drawn from 1.8-4.2s when SEARCH_INTERVAL is 3, so
# the requests keep their average rate without arriving on a metronome.
# 0 turns the randomisation off and restores a fixed interval.
SEARCH_INTERVAL_JITTER=0.4

# Korail session refresh
# A search that runs for hours outlives its Korail login, so the session is
# renewed before Korail closes it. Base interval in seconds; drawn afresh
# after every login within +/- the jitter below, so a long search does not
# re-authenticate on the half hour, every half hour.
# 0 stops renewing ahead of time and waits for Korail to reject the session,
# which the client already recovers from by logging in again.
RELOGIN_INTERVAL=1800
RELOGIN_INTERVAL_JITTER=0.4

# Korail app build
# The mobile app version the client reports. Leave unset to use whatever the
# korail2 library ships; set it when Korail stops serving that build and the
# library has not been updated yet (symptom: every request fails right after
# a Korail app update).
#KORAIL_APP_VERSION=250601002

# 알림에 실어 보내는 코레일 웹 주소
# 코레일이 letskorail.com 을 korail.com 으로 옮기고 사이트를 SPA 로 새로
# 만들면서 예전 .do 주소가 통째로 죽은 적이 있다. 같은 일이 또 일어나면
# 여기서 바로잡을 수 있다.
#
# 예매한 좌석을 결제하는 화면. 로그인이 안 되어 있으면 로그인 후 이 화면으로
# 돌아온다.
#KORAIL_PAYMENT_URL=https://www.korail.com/ticket/reservation/list
# 역 이름을 직접 입력해야 할 때 안내하는 역 목록.
#KORAIL_STATION_LIST_URL=https://www.korail.com/ticket/train/stationGuide/station
# SRT 로 예매한 좌석을 결제하는 화면. etk.srail.kr 은 SR 의 승차권 사이트다.
#SRT_PAYMENT_URL=https://etk.srail.kr/hpg/hra/02/selectReservationList.do

# Payment Timeout (minutes)
PAYMENT_TIMEOUT_MINUTES=10

# 결제 재촉 알림 간격(초). 기본 60 - 10분 창에 알림 9번.
#PAYMENT_REMINDER_INTERVAL=60

# 예약이 아직 미결제인지 철도사에 확인하는 간격(초).
# 조회 1회씩만 나가므로 취소표 검색보다 가볍다. 결제한 사람에게 몇 초 안에
# 알려주려면 이 값이 짧아야 한다.
#PAYMENT_VERIFY_INTERVAL=3

# 한 결제를 누가 감시하는지에 대한 선점이 유지되는 시간(초).
# 좌석을 잡은 검색 프로세스와 메인 앱이 같은 예약을 두 번 알리지 않게 한다.
# 기본은 확인 간격의 4배(최소 10초)라 프로세스가 죽으면 몇 초 만에 앱이 이어받는다.
#PAYMENT_WATCH_LEASE=12

# 검색 시작 시각 예약
# 기본 상한은 RESUME_TTL_SECONDS(3일)다. 예약된 검색이 쓸 로그인 정보가
# 그 기한으로 보관되므로, 더 멀리 잡으면 정작 그때 로그인할 수단이 없다.
#SCHEDULE_MAX_AHEAD_SECONDS=259200
# 예정 시각을 이만큼 넘겨도 아직 시작할 가치가 있다고 보는 범위(초).
# 그 시각에 봇이 재시작 중이었던 경우를 위한 것이다.
#SCHEDULE_GRACE_SECONDS=600

# 멈춘 검색 감시
# 검색 프로세스는 끝날 때 봇에 알려오고, 그 알림이 기록을 지운다. 죽는 경우만
# 예외라서 기록은 남고 아무도 모른다. 사용자 입장에서는 취소표가 아직 안 났을
# 때와 구분이 안 되므로, 아래 설정으로 감시해 알림과 재개 버튼을 보낸다.
#
# 갓 띄운 프로세스가 살아 있는지 확인하기 위해 기다리는 시간(초).
# 인터프리터가 잘못됐거나 의존성이 없으면 수 밀리초 만에 죽는다.
#PROCESS_START_GRACE_SECONDS=1.0
# 실행 중인 검색이 아직 살아 있는지 확인하는 간격(초).
# 검색이 죽고 나서 사용자가 알림을 받기까지 걸리는 시간이기도 하다.
#WATCHDOG_POLL_SECONDS=30
# 멈춘 검색을 재개할 수 있도록 보관하는 기간(초). 재개에 쓸 로그인 정보가
# RESUME_TTL_SECONDS로 만료되므로 그보다 길게 잡아도 의미가 없다.
#DEAD_SEARCH_TTL_SECONDS=259200

# Logging
LOG_LEVEL=INFO
